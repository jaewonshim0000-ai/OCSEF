{
  "name": "familiar-place",
  "private": true,
  "version": "0.2.0",
  "description": "Phone-first assistive app for people living with dementia: a four-button help screen behind an in-app lock, plus a daily companion.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.1.0",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "24.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "6.2.8",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
